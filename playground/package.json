{
  "name": "vue-uno-style-playground",
  "private": true,
  "type": "module",
  "description": "Nuxt playground for the built vue-uno-style package, deployed to GitHub Pages.",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "lint": "eslint . --ignore-pattern fixtures/",
    "verify:lint": "node scripts/check-lint.mjs",
    "verify:ssr": "node scripts/check-generated.mjs",
    "verify": "pnpm lint && pnpm verify:lint && pnpm generate && pnpm verify:ssr"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@unocss/nuxt": "^66.13.0",
    "eslint": "^10.15.0",
    "unocss": "^66.13.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-uno-style": "link:.."
  }
}
