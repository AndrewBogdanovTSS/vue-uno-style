{
  "name": "v-uno-style",
  "version": "0.1.0",
  "type": "module",
  "description": "Responsive runtime styles for Vue powered by UnoCSS.",
  "keywords": [
    "vue",
    "directive",
    "unocss",
    "responsive",
    "css-variables",
    "nuxt",
    "eslint"
  ],
  "license": "MIT",
  "author": "Andrii Bohdanov",
  "homepage": "https://github.com/AndrewBogdanovTSS/v-uno-style#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewBogdanovTSS/v-uno-style.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewBogdanovTSS/v-uno-style/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "import": "./dist/nuxt.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "tsx ./node_modules/eslint/bin/eslint.js src test eslint.config.js tsdown.config.ts vitest.config.ts",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.17",
    "eslint": ">=9",
    "unocss": ">=66",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "unocss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.5.2",
    "@types/node": "^26.6.1",
    "@unocss/config": "^66.10.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vitest": "^5.0.0",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  }
}
