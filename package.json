{
  "name": "vue-uno-style",
  "version": "0.1.0",
  "type": "module",
  "description": "Responsive runtime styles for Vue powered by UnoCSS.",
  "keywords": [
    "vue",
    "directive",
    "unocss",
    "responsive",
    "css-variables",
    "nuxt",
    "eslint"
  ],
  "license": "MIT",
  "author": "Andrii Bohdanov",
  "homepage": "https://github.com/AndrewBogdanovTSS/vue-uno-style#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewBogdanovTSS/vue-uno-style.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewBogdanovTSS/vue-uno-style/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "web-types": "./dist/web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "import": "./dist/nuxt.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsx scripts/build-web-types.ts",
    "lint": "tsx ./node_modules/eslint/bin/eslint.js src test scripts eslint.config.js tsdown.config.ts vitest.config.ts",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check:docs": "tsx scripts/check-docs.ts",
    "playground:install": "pnpm --dir playground install --frozen-lockfile",
    "playground:lint": "pnpm --dir playground lint",
    "playground:generate": "pnpm --dir playground generate",
    "playground:verify": "pnpm --dir playground verify",
    "playground:dev": "pnpm --dir playground dev",
    "scan": "pnpm audit --registry=https://registry.npmjs.org",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepublishOnly": "pnpm run build",
    "release": "tsx scripts/release.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.17",
    "@unocss/config": ">=66",
    "@unocss/nuxt": ">=66",
    "eslint": ">=9",
    "unocss": ">=66",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@unocss/config": {
      "optional": true
    },
    "@unocss/nuxt": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "unocss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.6.4",
    "@nuxt/schema": "^4.6.4",
    "@types/node": "^26.6.6",
    "@unocss/config": "^66.13.0",
    "@unocss/nuxt": "^66.13.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unocss": "^66.13.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2"
  }
}
